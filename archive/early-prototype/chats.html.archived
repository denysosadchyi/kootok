<!doctype html>
<html lang="uk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#245744">
<title>Куток: Чати</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700&amp;family=Onest:wght@500;600;700;800&amp;display=swap" rel="stylesheet">
<link rel="stylesheet" href="/kootok/tokens.css">
<link rel="stylesheet" href="/kootok/components/index.css">
<link rel="stylesheet" href="_base.css">
<link rel="stylesheet" href="/kootok/course-nav.css">
<script src="/kootok/course-nav.js" defer></script>
</head>
<body>
<div class="kit-shell">
  <header class="kit-shell__brand"><a href="listings.html" aria-label="Куток — на головну">Куток</a><span>Київ</span></header>
  <main class="kit-shell__body">
    <h1 class="kit-headline">Ваші розмови</h1>
    <p class="kit-meta">3 активні</p>
    <section class="kit-section">
      <div class="kit-card">
        <div class="kit-field">
          <label class="kit-sr-only" for="chat-search">Пошук у чатах</label>
          <input id="chat-search" type="search" placeholder="Знайти розмову">
        </div>
      </div>
      <div class="kit-card kit-card--list">
        <ul class="kit-chat-list">
          <li><a class="kit-chat-row kit-chat-row--unread" href="chat.html"><img class="kit-avatar" src="assets/avatars/mariia.png" alt=""><span class="kit-chat-copy"><strong>Марія та Олег</strong><span>Привіт! Переглянули вашу анкету…</span><small><span>Голосіїв · 8 500 ₴</span></small></span><span class="kit-chat-side"><time datetime="2026-08-27T10:42">10:42</time><span class="kit-unread" aria-label="1 непрочитане повідомлення">1</span></span></a></li>
          <li><a class="kit-chat-row" href="chat.html"><img class="kit-avatar" src="assets/avatars/nastia.png" alt=""><span class="kit-chat-copy"><strong>Настя</strong><span>Кімната ще актуальна, можна домовитись…</span></span><span class="kit-chat-side"><time datetime="2026-08-26">вчора</time></span></a></li>
          <li><a class="kit-chat-row" href="chat.html"><img class="kit-avatar" src="assets/avatars/oleh.png" alt=""><span class="kit-chat-copy"><strong>Антон і Даша</strong><span>Дякуємо за повідомлення</span></span><span class="kit-chat-side"><time datetime="2026-08-24">24 серп.</time></span></a></li>
        </ul>
      </div>
    </section>
    <p class="kit-footer">Куток · пошук співмешканців і кімнат у Києві</p>
  </main>
  <nav class="kit-tabbar product-header" aria-label="Глобальна навігація">
    <a class="kit-tab" href="listings.html">Пошук</a>
    <a class="kit-tab kit-tab--chats" href="chats.html" aria-current="page">Чати</a>
    <a class="kit-tab kit-tab--profile" href="profile.html">Профіль</a>
    <a class="kit-tab kit-tab--create" href="/kootok/research/wireframes/listing-new.html" aria-label="Додати оголошення">Додати</a>
  </nav>
</div>
</body>
</html>
