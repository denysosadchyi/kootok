<!doctype html>
<html lang="uk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#245744">
<title>Куток: Профіль</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700&family=Onest:wght@500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/kootok/tokens.css">
<link rel="stylesheet" href="/kootok/components/index.css">
<link rel="stylesheet" href="_base.css">
<link rel="stylesheet" href="/kootok/course-nav.css">
<script src="/kootok/course-nav.js" defer></script>
</head>
<body>
<div class="kit-shell">
  <header class="kit-shell__brand"><a href="listings.html" aria-label="Куток — на головну">Куток</a><span>Київ</span></header>
  <main class="kit-shell__body">

    <section class="kit-card kit-card--hero" aria-labelledby="profile-name">
      <img class="kit-avatar" src="assets/avatars/solomiia.png" width="1254" height="1254" alt="Соломія">
      <div>
        <p class="kit-profile-status">Активно шукаю</p>
        <h1 id="profile-name" class="kit-headline">Соломія, 24</h1>
        <p class="kit-meta">Київ · переїзд у вересні</p>
        <span class="kit-profile-proof">Телефон підтверджено</span>
      </div>
    </section>

    <section class="kit-section" aria-label="Параметри пошуку">
      <h2 class="kit-section__title">Параметри пошуку</h2>
      <div class="kit-card">
        <dl class="kit-kv">
          <div><dt>Бюджет</dt><dd>до 10 000 ₴</dd></div>
          <div><dt>Райони</dt><dd>Центр · Голосіїв</dd></div>
        </dl>
      </div>
    </section>

    <section class="kit-section" aria-labelledby="about-heading">
      <h2 id="about-heading" class="kit-section__title">Про мене</h2>
      <div class="kit-card">
        <p>Переїжджаю до Києва на нову роботу. Ціную спокійний побут, чистоту й чесні домовленості.</p>
      </div>
    </section>

    <section class="kit-section" aria-labelledby="habits-heading">
      <h2 id="habits-heading" class="kit-section__title">Побут і сумісність</h2>
      <div class="kit-card">
        <dl class="kit-kv">
          <div><dt>Режим</dt><dd>Рано лягаю, до 23:00</dd></div>
          <div><dt>Чистота</dt><dd>Прибираю щодня</dd></div>
          <div><dt>Гості</dt><dd>Рідко, завжди попереджаю</dd></div>
          <div><dt>Куріння</dt><dd>Не курю</dd></div>
        </dl>
        <a class="kit-button kit-button--secondary kit-button--block" href="compatibility-form.html">Редагувати анкету</a>
      </div>
    </section>

    <p class="kit-footer">Куток · пошук співмешканців і кімнат у Києві</p>
  </main>
  <nav class="kit-tabbar product-header" aria-label="Глобальна навігація">
    <a class="kit-tab" href="listings.html">Пошук</a>
    <a class="kit-tab kit-tab--chats" href="chats.html">Чати</a>
    <a class="kit-tab kit-tab--profile" href="profile.html" aria-current="page">Профіль</a>
    <a class="kit-tab kit-tab--create" href="/kootok/research/wireframes/listing-new.html" aria-label="Додати оголошення">Додати</a>
  </nav>
</div>
</body>
</html>
