<!-- ══ кінець спільної панелі ═══════════════════════════════════════ -->

<div class="stage">
<div class="sheet">

  <nav class="state-switch" aria-label="Стани екрана «Залишити відгук»">
    <span>Стани цього екрана:</span>
    <a href="review.html" data-page="review">основний вигляд</a>
    <a href="review-empty.html" data-page="review-empty">порожній</a>
    <a href="review-error.html" data-page="review-error">помилка</a>
    <a href="review-loading.html" data-page="review-loading">завантаження</a>
  </nav>

  <!-- Підпис до макета: не частина інтерфейсу -->
  <div class="annotation">
    <h1>Залишити відгук — стан «порожній»</h1>
    <p>Форма готова, але текст ще не введено. Контекст заселення та автор відгуку вже відомі.</p>
  </div>

  <div class="kit-shell">
    <header class="kit-shell__brand"><a href="../../index.html" aria-label="Куток — на головну">Куток</a><span>Київ</span></header>
    <header class="kit-shell__appbar"><a class="kit-back" href="chat.html" aria-label="Повернутися до чату">Назад</a><h1 class="kit-shell__title">Відгук</h1><img class="kit-appbar-avatar" src="../../ui/assets/avatars/mariia.png" alt="Оксана"></header>
    <main class="kit-shell__body">
      <section class="kit-section">
        <div class="kit-card kit-card--state">
          <div class="kit-state">
            <span class="kit-state__icon kit-state__icon--document"></span>
            <h3>Напиши про заселення</h3>
            <p>Розкажи, чи збіглася кімната з оголошенням і чи виконувалися домовленості.</p>
          </div>
        </div>
      </section>
      <form class="kit-form" action="review-loading.html" method="get">
        <fieldset class="kit-fieldset"><legend>Текст відгуку</legend>
          <div class="kit-field"><label class="kit-sr-only" for="review-text">Текст відгуку</label><textarea id="review-text" name="review-text" placeholder="Що було так, як в оголошенні? Як пройшло заселення?"></textarea></div>
        </fieldset>
        <div class="kit-actions">
          <button class="kit-button kit-button--block" type="submit" disabled>Опублікувати відгук</button>
        </div>
        <p class="kit-hint">Відгук буде підписано твоїм імʼям і показано в профілі Оксани.</p>
      </form>
      <p class="kit-footer">Куток · пошук співмешканців і кімнат у Києві</p>
    </main>
    <nav class="kit-tabbar" aria-label="Глобальна навігація">
      <a class="kit-tab" href="listings.html">Пошук</a>
      <a class="kit-tab kit-tab--chats" href="chats.html" aria-current="page">Чати</a>
      <a class="kit-tab kit-tab--profile" href="profile-edit.html">Профіль</a>
      <a class="kit-tab kit-tab--create" href="listing-new.html" aria-label="Додати оголошення">Додати</a>
    </nav>
  </div>
</div>
</div>

</div>

<!-- Позначає поточний вузол дерева й перемикача станів. Розмітка панелі
     завдяки цьому лишається байт-у-байт однаковою на всіх сторінках. -->
<script>
(function(){
  var page = document.body.dataset.page;
  document.querySelectorAll('a[data-page="' + page + '"]').forEach(function(a){
    a.setAttribute('aria-current', 'page');
    a.classList.remove('pending');
  });
})();
</script>

</body>
</html>
