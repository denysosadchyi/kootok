  "narrative": {
    "northStar": "Зелений двір",
    "overview": "«Куток» — теплий мобільний продукт, у якому темний лісовий зелений дає спокій і довіру, а живі фото кімнат та людей несуть основний емоційний зміст. Інтерфейс операційний і компактний: факти, сумісність і статус перевірки видно до контакту.\n\nСистема уникає декоративної нерухомості: ієрархію створюють фон, відступи, типографіка й тонкі розділювачі, а не тіні. Лаймовий акцент позначає вибір та активну навігацію; червоний і зелений стани завжди мають текст або іконку.",
    "keyCharacteristics": [
      "390px mobile-first полотно з одним стовпчиком і 16px gutter.",
      "Лісовий зелений #245744 на теплому полотні #f6f3ea; лайм #d8e99a лише для поточного стану.",
      "Jost 500–800 для заголовків, кнопок і labels; Golos Text 400–700 для тексту — обидва self-hosted.",
      "Реальні локальні фото (3:2 у стрічці, 4:3 у галереї) зі скримом і ціною поверх.",
      "Поверхні без тіней; глибина через фон, відступ і форму; радіуси 10/10/14/18/18.",
      "Solar Bold Duotone для навігації й станів, Solar Linear для малих фактів і стрілок."
    ],
    "rules": [
      {
        "name": "The Evidence Has Words Rule",
        "body": "Успіх, помилка й довіра ніколи не передаються лише кольором: поруч є Solar-іконка та короткий текст.",
        "section": "colors"
      },
      {
        "name": "The Lime Is Current Rule",
        "body": "Лайм позначає поточний вибір або один особливий момент; не фарбує бренд-марку й не кожну картку.",
        "section": "colors"
      },
      {
        "name": "The Two-Voice Rule",
        "body": "Jost відповідає за рішення й структуру (заголовки, кнопки, tabs, labels); Golos Text — за читання, введення, пояснення й meta.",
        "section": "typography"
      },
      {
        "name": "The Thumb-Zone Rule",
        "body": "Глобальна навігація, фільтри й головна дія залишаються в нижній зоні досяжності; кожна інтерактивна ціль має щонайменше 44px.",
        "section": "layout"
      },
      {
        "name": "The Zero-Shadow Rule",
        "body": "Якщо блок потребує видимості, спочатку змінюються фон, відступ або 1px структурна межа; тінь не додається.",
        "section": "elevation"
      },
      {
        "name": "The Pills Have A Job Rule",
        "body": "Пігулка має роль доказу, звички або фільтра; картки, форми й message bubbles не стають капсулами.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do починайте новий продуктовий екран із 390px одного стовпчика та 16px gutter.",
      "Do показуйте реальні фото, імена, райони, ціни й конкретні докази перевірки.",
      "Do спочатку додавайте компонент у design-system/, потім на екран.",
      "Do використовуйте Duotone для навігації/станів і Linear для метаданих та стрілок."
    ],
    "donts": [
      "Don't додавати тіні, glassmorphism або темну імітацію корпуса телефона.",
      "Don't кодувати довіру, помилку чи поточний стан лише кольором.",
      "Don't перетворювати картки, форми чи message bubbles на pills.",
      "Don't повертати фіолетовий, amber або декоративний бежевий як продуктовий акцент.",
      "Don't переносити стиль research-сторінок або DESIGN-artifacts.md у продукт."
